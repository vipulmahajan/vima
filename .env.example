# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# When true, the webhook bypasses Supabase/Claude and just echoes back with
# a ViMa greeting. Set to true only for the first-time wiring smoke test.
ECHO_MODE=false

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048

# --- Gupshup (WhatsApp + SMS) ---
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_SECRET=
# SMS OTP delivery. Often the same key as GUPSHUP_API_KEY.
GUPSHUP_SMS_API_KEY=
GUPSHUP_SMS_SOURCE=VIMACX

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=vima-artifacts

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pricing (paise; 179900 = Rs.1799/month) ---
PRICE_SUBSCRIPTION_PAISE=179900

# --- AWS (for voice transcription via Transcribe) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_TRANSCRIBE_S3_BUCKET=vima-transcribe

# --- Web auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
SESSION_TTL_DAYS=30

# --- Google OAuth (web sign-in) ---
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:8000/api/auth/google/callback (dev)
#                          https://yourdomain.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Public-facing site (landing + privacy) ---
# E.164 without leading '+' — used for the wa.me/<number> deeplink.
VIMA_WHATSAPP_NUMBER=919876543210
# Email shown in the privacy policy for data-deletion requests.
SUPPORT_EMAIL=hello@vima.coach
